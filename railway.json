{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "npm run build",
    "watchPatterns": [
      "index.html",
      "pages/**",
      "css/**",
      "images/**",
      "icons/**",
      "videos/**",
      "scripts/uap-*.js",
      "scripts/noticias-paginate.js",
      "scripts/build-static.js",
      "robots.txt",
      "sitemap.xml",
      "serve.json",
      "package.json",
      "package-lock.json",
      "railway.json"
    ]
  },
  "deploy": {
    "startCommand": "npm start",
    "healthcheckPath": "/",
    "healthcheckTimeout": 60,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
