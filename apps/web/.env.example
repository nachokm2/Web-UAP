# Copiar a .env y completar. Nunca commitear .env.

# PostgreSQL (local: npm run db:up). En Railway: ${{Postgres.DATABASE_URL}}
DATABASE_URL=postgresql://payload:payload@127.0.0.1:54329/uap_web

# Secreto para firmar sesiones. Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PAYLOAD_SECRET=

# URL pública canónica del sitio (sin barra final). Se lee en ejecución: cambiar el dominio
# no requiere recompilar (por eso no usa el prefijo NEXT_PUBLIC_, que Next incrusta en el build).
SITE_URL=http://localhost:3000

# Almacenamiento S3 (bucket de Railway). Si están vacías, los archivos se guardan en disco local (solo desarrollo).
S3_BUCKET=
S3_ENDPOINT=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Correo saliente por SMTP (Brevo: smtp-relay.brevo.com, puerto 587). Sin SMTP_HOST y
# CORREO_REMITENTE no se envía ningún correo (lib/correo.ts).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Dirección "De:" (del dominio verificado en el proveedor) y nombre que se muestra.
CORREO_REMITENTE=
CORREO_REMITENTE_NOMBRE=Universidad Autónoma del Paraguay
# Quién recibe el aviso de cada inscripción al Summit (separar con comas). Vacío: marketing@uap.edu.py.
SUMMIT_AVISO_PARA=
